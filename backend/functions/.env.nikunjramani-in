# Non-secret production runtime config, applied automatically by the Firebase CLI at
# deploy time (its own per-project dotenv convention — not a Secret Manager value).
# Real secrets (RESEND_API_KEY etc.) stay out of here; those come from Secret Manager.

# FIREBASE_PROJECT_ID is left unset — Firebase's dotenv loader reserves the FIREBASE_
# prefix and refuses to deploy the file if it's present. The Settings default
# ("nikunjramani-in") already matches, so nothing is lost.
ENVIRONMENT=production

ALLOWED_ORIGINS=https://nikunjramani.in,https://www.nikunjramani.in
SITE_URL=https://nikunjramani.in

STORAGE_BUCKET=nikunjramani-in-media
BACKUPS_BUCKET=nikunjramani-in-backups
MAIL_FROM=no-reply@nikunjramani.in
