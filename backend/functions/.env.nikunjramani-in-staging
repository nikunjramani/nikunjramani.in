# Non-secret staging runtime config — the staging twin of .env.nikunjramani-in, picked up by
# the Firebase CLI when deploying with --project nikunjramani-in-staging (ADR 0018).
# Real secrets stay in the staging project's Secret Manager, never here.

# Staging behaves like production on purpose: /docs off, Turnstile fails closed.
ENVIRONMENT=production

ALLOWED_ORIGINS=https://nikunjramani-in--nikunjramani-in-staging.asia-southeast1.hosted.app
SITE_URL=https://nikunjramani-in--nikunjramani-in-staging.asia-southeast1.hosted.app

STORAGE_BUCKET=nikunjramani-in-staging-media
BACKUPS_BUCKET=nikunjramani-in-staging-backups
MAIL_FROM=staging@nikunjramani.in
