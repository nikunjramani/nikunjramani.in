# Copy to .env for local development. NEVER commit .env — it is gitignored.
# Deployed config lives in deploy/<project>.yaml; secrets come from Secret Manager.

FIREBASE_PROJECT_ID=nikunjramani-in
ENVIRONMENT=development

# Firebase emulator hosts (local only — unset in production)
FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
FIREBASE_STORAGE_EMULATOR_HOST=localhost:9199

# Secrets — real values live in Secret Manager, never here
RESEND_API_KEY=
CONTACT_EMAIL_TO=

# CORS
ALLOWED_ORIGINS=http://localhost:3000,https://nikunjramani.in,https://www.nikunjramani.in
