rules_version = '2';

// Security posture, in one screen. See docs/plan/03-security.md and ADR 0007.
//
// Clients may read published content and may write NOTHING — not even the admin.
// Every mutation goes through the Python API, so validation, rate limiting and audit
// logging cannot be bypassed.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── BEGIN GENERATED: architecture/codegen/gen-rules.py — DO NOT EDIT BY HAND ──
    // Derived from every schema's `x-firestore.publicRead` flag and `required` list.
    // `make gen` regenerates this block; CI fails if it drifts from the schemas.
    // See ADR 0006 and docs/plan/phases/phase-1-schemas.md §1.6.

    function isPublicCollection(col) {
      return col in ['certifications', 'education', 'experience', 'posts', 'profile', 'projects', 'site_config', 'skills'];
    }

    // A publicly-readable document must carry every field its own schema requires —
    // on a doc missing one (a partial write caught mid-transaction, a bad manual
    // console edit) this evaluates to false, the read is denied, and the site
    // renders empty rather than serving a half-written document.
    function hasRequiredFields(col, data) {
      return col == 'certifications' ? isComplete_certifications(data) :
               col == 'education' ? isComplete_education(data) :
               col == 'experience' ? isComplete_experience(data) :
               col == 'posts' ? isComplete_posts(data) :
               col == 'profile' ? isComplete_profile(data) :
               col == 'projects' ? isComplete_projects(data) :
               col == 'site_config' ? isComplete_site_config(data) :
               col == 'skills' ? isComplete_skills(data) :
             false;
    }

    function isComplete_certifications(data) {
      return 'title' in data && 'issuer' in data && 'visibility' in data;
    }

    function isComplete_education(data) {
      return 'institution' in data && 'qualification' in data && 'visibility' in data;
    }

    function isComplete_experience(data) {
      return 'company' in data && 'role' in data && 'startDate' in data && 'current' in data && 'visibility' in data;
    }

    function isComplete_posts(data) {
      return 'slug' in data && 'title' in data && 'visibility' in data;
    }

    function isComplete_profile(data) {
      return 'name' in data && 'headline' in data && 'visibility' in data;
    }

    function isComplete_projects(data) {
      return 'slug' in data && 'title' in data && 'summary' in data && 'kind' in data && 'status' in data && 'visibility' in data;
    }

    function isComplete_site_config(data) {
      return 'visibility' in data;
    }

    function isComplete_skills(data) {
      return 'name' in data && 'category' in data && 'level' in data && 'visibility' in data;
    }

    // ── END GENERATED ──

    function isPublished() {
      return resource.data.visibility == 'public';
    }

    match /{col}/{id} {
      allow read: if isPublicCollection(col) && isPublished() && hasRequiredFields(col, resource.data);
      allow write: if false;
    }

    // contact_messages and audit_log are absent by design. Anything not named in
    // isPublicCollection falls through to default-deny, so a new collection is private
    // until someone consciously exposes it — rather than public until someone remembers
    // to deny it.
  }
}
