# Copy to .env.local. NEVER commit .env.local — it is gitignored.

# Public by design — identifies the project, authorises nothing.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=nikunjramani-in.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=nikunjramani-in
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=nikunjramani-in-media
NEXT_PUBLIC_FIREBASE_APP_ID=

# Base URL for the Python function domains (see next.config.ts rewrites).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
FUNCTIONS_BASE_URL=http://127.0.0.1:5001/nikunjramani-in/asia-south1

# Server-side only. Leave unset locally — the emulator uses ambient credentials.
FIREBASE_SERVICE_ACCOUNT=
REVALIDATE_TOKEN=

# Public by design — a Turnstile site key identifies the widget, not a secret. The
# matching TURNSTILE_SECRET_KEY lives in Secret Manager, read by the contact domain.
# Left unset locally, the contact form skips rendering the widget (see contact/turnstile.py:
# an unset secret key skips verification server-side too, so dev submissions still work).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Local dev only — points the Admin SDK at the Firestore emulator instead of production.
# Never set in a deployed environment.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
