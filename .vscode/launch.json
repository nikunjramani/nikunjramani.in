{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend: debug the API",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["apps.api:app", "--port", "8000"],
      "cwd": "${workspaceFolder}/backend",
      "env": {
        "FIRESTORE_EMULATOR_HOST": "127.0.0.1:8080",
        "FIREBASE_AUTH_EMULATOR_HOST": "127.0.0.1:9099",
        "FIREBASE_STORAGE_EMULATOR_HOST": "127.0.0.1:9199",
        "GOOGLE_CLOUD_PROJECT": "nikunjramani-in",
        "ENVIRONMENT": "development"
      },
      "justMyCode": true,
      "preLaunchTask": "emulators: data services",
      "presentation": { "group": "backend", "order": 1 }
    },
    {
      "name": "Backend: debug pytest (current file)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}", "-v", "-s"],
      "cwd": "${workspaceFolder}/backend",
      "env": {
        "FIRESTORE_EMULATOR_HOST": "127.0.0.1:8080",
        "GOOGLE_CLOUD_PROJECT": "nikunjramani-in"
      },
      "justMyCode": true,
      "presentation": { "group": "backend", "order": 2 }
    },
    {
      "name": "Backend: debug all tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-v"],
      "cwd": "${workspaceFolder}/backend",
      "env": {
        "FIRESTORE_EMULATOR_HOST": "127.0.0.1:8080",
        "GOOGLE_CLOUD_PROJECT": "nikunjramani-in"
      },
      "justMyCode": true,
      "presentation": { "group": "backend", "order": 3 }
    },
    {
      "name": "Frontend: debug full stack",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}/frontend",
      "serverReadyAction": {
        "pattern": "Local:\\s+(https?://\\S+)",
        "uriFormat": "%s",
        "action": "debugWithChrome"
      },
      "presentation": { "group": "frontend", "order": 1 }
    }
  ],
  "compounds": [
    {
      "name": "Full stack: API + frontend",
      "configurations": ["Backend: debug the API", "Frontend: debug full stack"],
      "stopAll": true,
      "presentation": { "group": "compound", "order": 1 }
    }
  ]
}
