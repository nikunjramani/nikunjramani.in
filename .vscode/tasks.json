{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "emulators: data services",
      "detail": "Firestore + Auth + Storage — what the API runs against locally (`Backend: debug the API` in launch.json, or `make dev-backend`).",
      "type": "shell",
      "command": "firebase emulators:start --only firestore,auth,storage --project nikunjramani-in",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^never_matches_anything$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting emulators",
          "endsPattern": "All emulators ready"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "emulators"
      }
    },
    {
      "label": "frontend: dev server",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^never_matches_anything$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting",
          "endsPattern": "Ready in"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "frontend"
      }
    }
  ]
}
